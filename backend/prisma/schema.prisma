generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id                Int                @id @default(autoincrement())
  name              String
  seoLevel          String?            @default("RENFORCEMENT")
  city              String
  address           String
  postalCode        String
  phone             String
  email             String
  website           String?
  googleReviewUrl   String?
  googleLocationId  String?
  createdAt         DateTime           @default(now())
  networkActions    NetworkAction[]
  realRankingChecks RealRankingCheck[]
  reviewRequests    ReviewRequest[]

  googlePosts       GooglePost[]
  reviews           GoogleReview[]
  keywords          RankingKeyword[]
  directoryListings DirectoryListing[]
  scoreHistory      AgencyScoreHistory[]
  notifications     Notification[]
  ReviewResponse    ReviewResponse[]

  seoSite AgencySeoSite?

  @@unique([name, city])
  agencySites AgencySite[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  agencyId  Int?
  type      String
  level     String   @default("info")
  title     String
  message   String
  status    String   @default("open")
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agency Agency? @relation(fields: [agencyId], references: [id])
}

model AgencyScoreHistory {
  id            Int      @id @default(autoincrement())
  agencyId      Int
  citationScore Int
  globalScore   Int
  reviewsCount  Int
  rankingsCount Int
  createdAt     DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id])
}

model GoogleReview {
  id             Int       @id @default(autoincrement())
  agencyId       Int
  authorName     String
  rating         Int
  comment        String?
  reply          String?
  status         String    @default("new")
  source         String    @default("manual")
  googleReviewId String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
}

model RankingKeyword {
  id               Int      @id @default(autoincrement())
  agencyId         Int
  keyword          String
  city             String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  dataforseoTaskId String?
  lastCheckStatus  String?

  agency  Agency          @relation(fields: [agencyId], references: [id])
  results RankingResult[]
}

model RankingResult {
  id        Int      @id @default(autoincrement())
  keywordId Int
  position  Int?
  found     Boolean  @default(false)
  checkedAt DateTime @default(now())

  keyword RankingKeyword @relation(fields: [keywordId], references: [id])
}

model LocalDirectory {
  id          Int      @id @default(autoincrement())
  name        String
  website     String
  category    String   @default("general")
  impactScore Int      @default(3)
  difficulty  Int      @default(2)
  priority    Int      @default(2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  listings DirectoryListing[]

  @@unique([name])
}

model GoogleToken {
  id           Int      @id @default(autoincrement())
  provider     String   @default("google")
  accessToken  String?
  refreshToken String?
  expiryDate   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ReviewRequest {
  id          Int       @id @default(autoincrement())
  agencyId    Int
  clientName  String
  clientPhone String?
  clientEmail String?
  channel     String    @default("whatsapp")
  status      String    @default("draft")
  message     String
  reviewUrl   String?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
}

model GooglePost {
  id                 Int       @id @default(autoincrement())
  agencyId           Int
  title              String
  content            String
  ctaLabel           String?
  ctaUrl             String?
  status             String    @default("draft")
  plannedAt          DateTime?
  publishedAt        DateTime?
  googlePostName     String?
  lastPublishError   String?
  publishedUrl       String?
  seoScore           Int?      @default(0)
  seoKeyword         String?
  imageCategory      String?
  imageUrl           String?
  duplicateStatus    String?
  editorialSignature String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id])
}

model DirectoryListing {
  id          Int     @id @default(autoincrement())
  agencyId    Int
  directoryId Int
  listingUrl  String?
  status      String  @default("todo")

  nameCorrect     Boolean @default(false)
  addressCorrect  Boolean @default(false)
  phoneCorrect    Boolean @default(false)
  websiteCorrect  Boolean @default(false)
  hoursCorrect    Boolean @default(false)
  categoryCorrect Boolean @default(false)

  notes         String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agency    Agency         @relation(fields: [agencyId], references: [id])
  directory LocalDirectory @relation(fields: [directoryId], references: [id])

  @@unique([agencyId, directoryId])
}

model NetworkAction {
  id Int @id @default(autoincrement())

  agencyId Int?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  lever       String
  title       String
  description String?

  owner    String?
  deadline DateTime?

  status  String  @default("todo")
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RealRankingCheck {
  id       Int     @id @default(autoincrement())
  agencyId Int?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  keyword          String
  city             String
  found            Boolean @default(false)
  position         Int?
  absolutePosition Int?
  rating           Float?
  reviews          Int?
  title            String?
  url              String?
  cost             Float?

  checkedAt DateTime @default(now())
}

model ReviewResponse {
  id           Int       @id @default(autoincrement())
  reviewId     Int?
  agencyId     Int?
  reviewAuthor String?
  reviewRating Int?
  reviewText   String?
  responseText String?
  status       String?   @default("draft")
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  agency Agency? @relation(fields: [agencyId], references: [id])
}

//
// MARKETING KNOWLEDGE GRAPH — SPRINT 003A
//

model KnowledgeEntity {
  id          String    @id @default(cuid())
  type        String
  slug        String
  title       String
  summary     String?
  status      String    @default("draft")
  language    String    @default("fr")
  metadata    Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  outgoingRelations KnowledgeRelation[]     @relation("KnowledgeRelationSource")
  incomingRelations KnowledgeRelation[]     @relation("KnowledgeRelationTarget")
  contentBlocks     KnowledgeContentBlock[]
  mediaAssets       KnowledgeMediaAsset[]

  seoPages AgencySeoPage[]

  @@unique([slug, language])
  @@index([type])
  @@index([status])
  @@index([language])
  @@index([publishedAt])
}

model KnowledgeRelation {
  id           String   @id @default(cuid())
  sourceId     String
  targetId     String
  relationType String
  position     Int      @default(0)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source KnowledgeEntity @relation("KnowledgeRelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target KnowledgeEntity @relation("KnowledgeRelationTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId])
  @@index([targetId])
  @@index([relationType])
}

model KnowledgeContentBlock {
  id        String   @id @default(cuid())
  entityId  String
  type      String
  title     String?
  content   Json
  position  Int      @default(0)
  status    String   @default("draft")
  language  String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([type])
  @@index([status])
  @@index([language])
  @@index([entityId, position])
}

model KnowledgeMediaAsset {
  id        String   @id @default(cuid())
  entityId  String
  type      String
  url       String
  alt       String?
  title     String?
  mimeType  String?
  width     Int?
  height    Int?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([type])
  @@index([entityId, position])
  @@index([entityId, isPrimary])
}

model AgencySeoSite {
  id           String   @id @default(cuid())
  agencyId     Int      @unique
  name         String
  slug         String   @unique
  domain       String?  @unique
  subdomain    String?  @unique
  seoCity      String
  targetCities Json?
  status       String   @default("draft")
  theme        Json?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pages  AgencySeoPage[]

  @@index([status])
  @@index([seoCity])
}

model AgencySeoPage {
  id                String    @id @default(cuid())
  siteId            String
  knowledgeEntityId String?
  slug              String
  title             String
  pageType          String    @default("destination")
  localCity         String?
  seoTitle          String?
  seoDescription    String?
  introduction      String?
  content           Json?
  callToAction      Json?
  status            String    @default("draft")
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  site            AgencySeoSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  knowledgeEntity KnowledgeEntity? @relation(fields: [knowledgeEntityId], references: [id], onDelete: SetNull)

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([knowledgeEntityId])
  @@index([status])
  @@index([pageType])
}

// ======================================================
// MINI SITE FACTORY
// ======================================================

model MiniSite {
  id         String  @id @default(cuid())
  agencyId   String
  name       String
  slug       String  @unique
  domain     String?
  status     String  @default("draft")
  templateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages MiniSitePage[]

  @@index([agencyId])
}

model MiniSitePage {
  id String @id @default(cuid())

  miniSiteId String

  title String
  slug  String
  type  String

  seoTitle String?
  seoDesc  String?

  content Json

  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  miniSite MiniSite @relation(fields: [miniSiteId], references: [id], onDelete: Cascade)

  @@unique([miniSiteId, slug])
  @@index([type])
}

model MiniSiteTemplate {
  id String @id @default(cuid())

  name String
  code String @unique

  description String?

  config Json

  createdAt DateTime @default(now())
}

// ======================================================
// ASSET ENGINE
// Source commune et versionnée des contenus Mondescale
// ======================================================

model Asset {
  id             String    @id @default(cuid())
  tenantId       String
  type           String
  status         String    @default("draft")
  title          String
  slug           String
  summary        String?
  payload        Json
  metadata       Json?
  tags           String[]  @default([])
  currentVersion Int       @default(1)
  createdBy      String?
  updatedBy      String?
  publishedAt    DateTime?
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  versions AssetVersion[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([createdAt])
}

model AssetVersion {
  id        String   @id @default(cuid())
  assetId   String
  version   Int
  title     String
  summary   String?
  payload   Json
  metadata  Json?
  tags      String[] @default([])
  createdBy String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
  @@index([assetId])
  @@index([createdAt])
}


// ======================================================
// SPRINT 007A - AGENCY SITE GENERATOR
// ======================================================
model AgencySite {
  id          String   @id @default(cuid())
  agencyId    Int      @unique
  name        String
  slug        String   @unique
  basePath    String   @unique
  status      String   @default("draft")
  theme       String   @default("mondescale-default")
  generatedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  pages  AgencySitePage[]

  @@index([status])
}

model AgencySitePage {
  id              String   @id @default(cuid())
  siteId          String
  parentId        String?
  title           String
  slug            String
  path            String   @unique
  pageType        String
  menuTitle       String
  menuLocation    String
  displayOrder    Int
  seoTitle        String
  metaDescription String
  h1              String
  schemaType      String   @default("WebPage")
  status          String   @default("draft")
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  site     AgencySite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   AgencySitePage?  @relation("AgencySitePageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children AgencySitePage[] @relation("AgencySitePageTree")

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([parentId])
  @@index([pageType])
  @@index([menuLocation, displayOrder])
  @@index([status])
  sections AgencySiteSection[]
}


// SPRINT 007B - STRUCTURED PAGE CONTENT
model AgencySiteSection {
  id           String   @id @default(cuid())
  pageId       String
  sectionType  String
  jsonContent  Json
  displayOrder Int
  status       String   @default("draft")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page AgencySitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionType])
  @@index([pageId, displayOrder])
  @@index([sectionType])
  @@index([status])
}

// ======================================================
// DESTINATION ENGINE v0.8.0-alpha
// ======================================================
model Destination {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  country        String
  region         String?
  type           String   @default("destination")
  status         String   @default("draft")
  tagline        String?
  summary        String?
  heroImageUrl   String?
  seoTitle       String?
  seoDescription String?
  latitude       Float?
  longitude      Float?
  bestTime       String?
  idealDuration  String?
  currency       String?
  language       String?
  highlights     String[] @default([])
  audiences      String[] @default([])
  metadata       Json?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sections DestinationSection[]
  faqs     DestinationFaq[]

  countryId String?
  regionId String?
  cityId String?
  countryRef Country? @relation(fields:[countryId], references:[id], onDelete:SetNull)
  regionRef Region? @relation(fields:[regionId], references:[id], onDelete:SetNull)
  cityRef City? @relation(fields:[cityId], references:[id], onDelete:SetNull)
  themes DestinationTheme[]
  travelTypes DestinationTravelType[]
  tags DestinationTag[]
  relationsFrom DestinationRelation[] @relation("DestinationRelationsFrom")
  relationsTo DestinationRelation[] @relation("DestinationRelationsTo")

  @@index([status])
  @@index([country])
  @@index([type])
}

model DestinationSection {
  id            String   @id @default(cuid())
  destinationId String
  key           String
  position      Int      @default(0)
  type          String
  title         String?
  content       Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, key])
  @@index([destinationId, position])
}

model DestinationFaq {
  id            String   @id @default(cuid())
  destinationId String
  position      Int      @default(0)
  question      String
  answer        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, position])
  @@index([destinationId, position])
}


// ======================================================
// KNOWLEDGE GRAPH FOUNDATION v0.9.0
// Bundle 004.2A
// ======================================================
model Country {
  id String @id @default(cuid())
  name String
  slug String @unique
  iso2 String? @unique
  iso3 String? @unique
  continent String?
  currency String?
  languages String[] @default([])
  timezone String?
  status String @default("draft")
  metadata Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  regions Region[]
  cities City[]
  destinations Destination[]
  @@index([status])
  @@index([continent])
}
model Region {
  id String @id @default(cuid())
  countryId String
  name String
  slug String
  code String?
  status String @default("draft")
  metadata Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  country Country @relation(fields:[countryId], references:[id], onDelete:Cascade)
  cities City[]
  destinations Destination[]
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([status])
}
model City {
  id String @id @default(cuid())
  countryId String
  regionId String?
  name String
  slug String
  latitude Float?
  longitude Float?
  status String @default("draft")
  metadata Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  country Country @relation(fields:[countryId], references:[id], onDelete:Cascade)
  region Region? @relation(fields:[regionId], references:[id], onDelete:SetNull)
  destinations Destination[]
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([regionId])
  @@index([status])
}
model Theme {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  status String @default("draft")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  destinations DestinationTheme[]
  @@index([status])
}
model TravelType {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  status String @default("draft")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  destinations DestinationTravelType[]
  @@index([status])
}
model Tag {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  status String @default("active")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  destinations DestinationTag[]
  @@index([status])
}
model DestinationTheme {
  destinationId String
  themeId String
  weight Int @default(100)
  createdAt DateTime @default(now())
  destination Destination @relation(fields:[destinationId], references:[id], onDelete:Cascade)
  theme Theme @relation(fields:[themeId], references:[id], onDelete:Cascade)
  @@id([destinationId, themeId])
  @@index([themeId])
}
model DestinationTravelType {
  destinationId String
  travelTypeId String
  weight Int @default(100)
  createdAt DateTime @default(now())
  destination Destination @relation(fields:[destinationId], references:[id], onDelete:Cascade)
  travelType TravelType @relation(fields:[travelTypeId], references:[id], onDelete:Cascade)
  @@id([destinationId, travelTypeId])
  @@index([travelTypeId])
}
model DestinationTag {
  destinationId String
  tagId String
  createdAt DateTime @default(now())
  destination Destination @relation(fields:[destinationId], references:[id], onDelete:Cascade)
  tag Tag @relation(fields:[tagId], references:[id], onDelete:Cascade)
  @@id([destinationId, tagId])
  @@index([tagId])
}


// ======================================================
// KNOWLEDGE ENGINE v0.9.1
// Bundle 004.2B
// ======================================================
model KnowledgeAlias {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  alias           String
  normalizedAlias String
  locale          String   @default("fr")
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityType, entityId, normalizedAlias, locale])
  @@index([entityType, entityId])
  @@index([normalizedAlias])
  @@index([locale])
}

model DestinationRelation {
  id           String      @id @default(cuid())
  sourceId     String
  targetId     String
  relationType String      @default("similar")
  score        Int         @default(50)
  origin       String      @default("manual")
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  source       Destination @relation("DestinationRelationsFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Destination @relation("DestinationRelationsTo", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, relationType])
  @@index([sourceId, relationType, score])
  @@index([targetId, relationType])
}
