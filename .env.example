POSTGRES_USER=mle_user
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=mondescale_local_engine
DATABASE_URL=postgresql://mle_user:replace-me@postgres:5432/mondescale_local_engine

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_BUSINESS_ACCOUNT_ID=replace-me
GOOGLE_REDIRECT_URI=https://localengine.mondescale.com/api/google/callback

DATAFORSEO_ENABLED=true
DATAFORSEO_LOGIN=replace-me
DATAFORSEO_PASSWORD=replace-me

BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=replace-me

# Back-office Marketing Engine / Local Engine
NEXT_PUBLIC_SITE_URL=https://localengine.mondescale.com
PUBLIC_SITE_URL=https://localengine.mondescale.com

# Surface publique des mini-sites agences (canonical, JSON-LD, sitemap)
NEXT_PUBLIC_SITE_ORIGIN=https://agences.mondescale.com
PUBLIC_SITE_ORIGIN=https://agences.mondescale.com
NEXT_PUBLIC_TENANT_SLUG=mondescale
TENANT_SLUG=mondescale

# Google Search Console sitemap submission
# Disabled by default. Enable only after the read-only preflight succeeds.
SEARCH_CONSOLE_ENABLED=false
# Runtime path only; never commit the referenced credential JSON.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/mondescale/search-console.json
# Operator/preflight target. The service account must be siteOwner on this property.
SEARCH_CONSOLE_SITE_URL=sc-domain:agences.mondescale.com

# Site vitrine / catalogue de voyages utilisé par les CTA « Découvrir nos voyages »
NEXT_PUBLIC_SHOWCASE_URL=https://mondescale.com
